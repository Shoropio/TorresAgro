rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/{collection}/{documentId} {
      allow read, create, update, delete: if ownsUserDocument(userId)
        && collection in [
          'parcels',
          'tasks',
          'activities',
          'observations',
          'inventory'
        ];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
