rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsPath(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /activities/{userId}/{allPaths=**} {
      allow read, write: if ownsPath(userId);
    }

    match /observations/{userId}/{allPaths=**} {
      allow read, write: if ownsPath(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
